# ── Firebase 웹 앱 config ──────────────────────────────────────────
# Firebase 콘솔 → 프로젝트 설정 → 일반 → "내 앱"의 웹 앱에서 firebaseConfig 값을 그대로 옮겨 적으세요.
# (cruise-unified 프로젝트를 재사용하는 경우, 기존 웹 앱이 있으면 그 config를 그대로 써도 됩니다)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (서버 전용) ─────────────────────────────────
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → "새 비공개 키 생성"으로 받은 JSON 파일에서
# project_id / client_email / private_key 값을 그대로 옮겨 적으세요.
# private_key는 줄바꿈이 \n으로 이스케이프된 상태 그대로, 큰따옴표로 감싸서 붙여넣으면 됩니다.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
